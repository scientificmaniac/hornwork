# 默认：文本文件自动识别换行，仓库内统一 LF
* text=auto eol=lf

# 源码与文档显式使用 LF
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.sh    text eol=lf
*.bash  text eol=lf
*.rules text eol=lf
*.yar   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.conf  text eol=lf
*.service text eol=lf
*.timer text eol=lf
LICENSE text eol=lf
NOTICE  text eol=lf
Makefile text eol=lf

# Windows 脚本使用 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.bmp   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.bz2   binary
*.xz    binary
*.7z    binary
*.tar   binary
*.tgz   binary
*.whl   binary
*.so    binary
*.so.*  binary
*.o     binary
*.a     binary
*.pyc   binary
*.db    binary
*.db-wal binary
*.db-shm binary
*.sqlite binary

# Git 自身
.gitattributes text eol=lf
.gitignore     text eol=lf

# 语言统计：把数据/规则目录标记为文档，避免把演示数据算进主语言
rules/** linguist-documentation
docs/**  linguist-documentation
deploy/** linguist-documentation
