        <criterion comment="openssl before 3.0.13-1ubuntu1" test_ref="oval:com.ubuntu.test:tst:1"/>
      </criteria>
    </definition>
    <definition class="vulnerability" id="oval:com.ubuntu.test:def:2" version="1">
      <metadata>
        <title>CVE-2099-77777 测试夹具（非真实漏洞）</title>
        <affected family="unix">
          <platform>Ubuntu 24.04 LTS</platform>
        </affected>
        <reference source="CVE" ref_id="CVE-2099-77777"/>
        <description>openssh-server before 1:9.3p1-1ubuntu3 (fixture, via extend_definition)</description>
      </metadata>
      <criteria operator="AND">
        <criteria operator="OR">
          <extend_definition definition_ref="oval:com.ubuntu.test:def:3" comment="openssh-server package check"/>
        </criteria>
      </criteria>
    </definition>
    <definition class="patch" id="oval:com.ubuntu.test:def:3" version="1">
      <metadata>
        <title>openssh-server package check definition (fixture)</title>
        <description>仅作为被 extend_definition 引用的包定义</description>
      </metadata>
      <criteria operator="OR">
        <criterion comment="openssh-server before 1:9.3p1-1ubuntu3"
                   test_ref="oval:com.ubuntu.test:tst:2"/>
      </criteria>
    </definition>
  </definitions>
  <tests>
    <dpkginfo_test id="oval:com.ubuntu.test:tst:1" version="1" check="all"
                   comment="openssl package/version">
      <object object_ref="oval:com.ubuntu.test:obj:1"/>
      <state state_ref="oval:com.ubuntu.test:ste:1"/>
    </dpkginfo_test>
    <dpkginfo_test id="oval:com.ubuntu.test:tst:2" version="1" check="all"
                   comment="openssh-server package/version">
      <object object_ref="oval:com.ubuntu.test:obj:2"/>
      <state state_ref="oval:com.ubuntu.test:ste:2"/>
    </dpkginfo_test>
  </tests>
  <objects>
