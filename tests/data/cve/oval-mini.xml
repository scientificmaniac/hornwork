        <title>CVE-2099-88888 测试夹具（非真实漏洞）</title>
        <affected family="unix">
          <platform>Ubuntu 24.04 LTS</platform>
          <product>openssl</product>
        </affected>
        <reference source="CVE" ref_id="CVE-2099-88888"
                   ref_url="https://example.invalid/CVE-2099-88888"/>
