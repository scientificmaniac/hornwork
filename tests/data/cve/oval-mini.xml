<?xml version="1.0" encoding="UTF-8"?>
<!--
  测试夹具（非真实 OVAL 数据）：只保留 Ubuntu OVAL 的关键结构——
  definition(metadata CVE 引用 + criteria/criterion test_ref)、dpkginfo_test、
  dpkginfo_object(name=dpkg 包名)、dpkginfo_state(evr less than 修复版本)，
  外加 patch 定义与 extend_definition 组合（验证"包定义被漏洞定义引用"的解析路径）。
  CVE-2099-88888 / CVE-2099-77777 为明显虚构的夹具编号，不对应真实漏洞。
-->
<oval_definitions
